# App
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (used by the postgres service and to build DATABASE_URL)
POSTGRES_USER=protoflow
POSTGRES_PASSWORD=protoflow
POSTGRES_DB=protoflow

# Backend
DATABASE_URL=postgresql+asyncpg://protoflow:protoflow@localhost:5432/protoflow
REDIS_URL=redis://localhost:6379/0

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# LLM provider — switch between "mock" (offline), "openai", or "ollama"
LLM_PROVIDER=mock

# OpenAI-compatible provider (OpenAI, Azure AI Foundry, local, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Ollama Cloud (OpenAI-compatible endpoint). Get a key at https://ollama.com
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Developer-team LLM (Epics 6-7: AI development & QA). Leave blank to inherit the shared
# provider/model above; set these to run the dev/QA agents on a different provider or model.
DEV_LLM_PROVIDER=
DEV_OPENAI_API_KEY=
DEV_OPENAI_BASE_URL=
DEV_OPENAI_MODEL=
DEV_OLLAMA_API_KEY=
DEV_OLLAMA_BASE_URL=
DEV_OLLAMA_MODEL=

# LangSmith tracing — set LANGSMITH_TRACING=true and add your key to monitor the chains
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=protoflow
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
